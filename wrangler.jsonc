{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abod-dev",
  "main": "worker.js",
  "account_id": "61de27a935e77a704642b3a720b67f03",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "routes": [
    { "pattern": "abod.dev", "custom_domain": true },
    { "pattern": "www.abod.dev/*", "zone_name": "abod.dev" }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
