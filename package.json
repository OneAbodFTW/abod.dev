{
  "name": "abod-dev",
  "version": "3.0.0",
  "private": true,
  "description": "Abod's portfolio, project archive, and writing.",
  "author": "Abdulqader Mohammed <hello@abod.dev>",
  "repository": "OneAbodFTW/abod.dev",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "preview": "bun run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "run-p test:*",
    "test:lint": "eslint .",
    "test:typecheck": "tsc --noEmit",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx,css,mdx}' --check"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "gray-matter": "^4.0.3",
    "next": "^15.5.7",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "wrangler": "4.158.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  }
}
